# Copier en .env.local et remplir les valeurs.
# Sur Vercel : Project → Settings → Environment Variables

# Base de données (Neon / PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Dev local sans Neon (make db-up) : proxy Neon HTTP de compose.yaml. Les
# workflows make (dev, db-push…) tournent dans des conteneurs : localhost y
# désigne le conteneur — il faut donc le nom du service.
# DATABASE_URL=postgresql://postgres:postgres@neon-proxy:4444/main

# Cloudinary (utilisé pour l'upload des photos des points d'incendie)
# Remplacer <api_key>, <api_secret> et <cloud_name> par vos valeurs.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Fond de carte IGN SCAN 25 (facultatif — l'option n'apparaît que si défini).
# ign_scan_ws est la clé transitoire publique de l'IGN ; pour la production,
# créer sa propre clé sur https://cartes.gouv.fr (données SCAN, clé HASH).
NEXT_PUBLIC_IGN_KEY=ign_scan_ws
